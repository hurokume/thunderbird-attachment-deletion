{
    "manifest_version": 3,
    "name": "__MSG_extensionName__",
    "version": "0.1.5",
    "description": "__MSG_extensionDescription__",
    "author": "hurokume",
    "icons": {
        "16": "images/icon.svg",
        "32": "images/icon.svg",
        "48": "images/icon.svg",
        "64": "images/icon.svg",
        "128": "images/icon.svg"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "hurokume.bulk-attach-deleter@addons.thunderbird.net",
            "strict_min_version": "128.0"
        }
    },
    "permissions": [
        "messagesRead",
        "messagesModifyPermanent",
        "menus",
        "notifications",
        "downloads",
        "storage"
    ],
    "background": {
        "scripts": [
            "bg/globals.js",
            "shared/i18n.js",
            "bg/utils.js",
            "bg/settings.js",
            "bg/downloads.js",
            "bg/ui.js",
            "bg/mail.js",
            "bg/runner.js",
            "bg/main.js"
        ]
    },
    "options_ui": {
        "page": "ui/options.html",
        "open_in_tab": true
    },
    "default_locale": "en"
}
